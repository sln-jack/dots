#!/usr/bin/env bash

export DOTS=$(dirname $(readlink -f "$0"))

export PATH_NODOTS=${PATH_NODOTS-$PATH}
export LD_LIBRARY_PATH_NODOTS=${LD_LIBRARY_PATH_NODOTS-$LD_LIBRARY_PATH}
export PYTHONPATH_NODOTS=${PYTHONPATH_NODOTS-$PYTHONPATH}
export XDG_CONFIG_HOME_NODOTS=${XDG_CONFIG_HOME_NODOTS-$XDG_CONFIG_HOME}
export XDG_DATA_HOME_NODOTS=${XDG_DATA_HOME_NODOTS-$XDG_DATA_HOME}
export RUSTUP_HOME_NODOTS=${RUSTUP_HOME_NODOTS-$RUSTUP_HOME}
export CARGO_HOME_NODOTS=${CARGO_HOME_NODOTS-$CARGO_HOME}
export DOTNET_ROOT_NODOTS=${DOTNET_ROOT_NODOTS-$DOTNET_ROOT}
export STARSHIP_CONFIG_NODOTS=${STARSHIP_CONFIG_NODOTS-$STARSHIP_CONFIG}
export CODEX_HOME_NODOTS=${CODEX_HOME_NODOTS-$CODEX_HOME}
export BROWSER_NODOTS=${BROWSER_NODOTS-$BROWSER}

export PATH="$DOTS/prefix/bin:$HOME/.cargo/bin:$PATH_NODOTS"
export LD_LIBRARY_PATH="$DOTS/prefix/lib:$LD_LIBRARY_PATH_NODOTS"
export PYTHONPATH="$DOTS/prefix/lib/python:$PYTHONPATH_NODOTS"
export XDG_CONFIG_HOME=$DOTS/prefix/config
export XDG_DATA_HOME=$DOTS/prefix/share
export RUSTUP_HOME=$DOTS/prefix/pkgs/rust/rustup
export CARGO_HOME=$DOTS/prefix/cache/cargo
export DOTNET_ROOT=$DOTS/prefix/pkgs/dotnet
export STARSHIP_CONFIG=$DOTS/prefix/config/starship.toml
export CODEX_HOME=$DOTS/prefix/config/codex
export BROWSER=zen

mkdir -p $CARGO_HOME

exec fish
